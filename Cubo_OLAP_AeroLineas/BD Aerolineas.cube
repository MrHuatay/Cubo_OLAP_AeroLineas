  <MdxScripts>
    <MdxScript dwd:design-time-name="10665092-dd5e-4b8d-8eb1-25980b47e7ad">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Total Minutos Retraso]
 AS [Measures].[Fact Demora Vuelo Minutos Retraso Salida]+[Measures].[Fact Demora Vuelo Minutos Retraso Llegada], 
FORMAT_STRING = "Standard", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Demora Vuelo'  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Costo Total Demoras]
 AS [Measures].[Fact Demora Vuelo Costo Operativo Adicional USD]+[Measures].[Fact Demora Vuelo Monto Indemnizacion USD], 
FORMAT_STRING = "Currency", 
VISIBLE = 1 ,  ASSOCIATED_MEASURE_GROUP = 'Fact Demora Vuelo'  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="fbae168b-0346-4da5-bf4c-d0e355b00be9">
      <ID>KPI</ID>
      <Name>KPI Puntualidad</Name>
      <AssociatedMeasureGroupID>Fact Demora Vuelo</AssociatedMeasureGroupID>
      <Value>[Measures].[Total Minutos Retraso]</Value>
      <Goal>5000</Goal>
      <Status>Case
  When [Measures].[Total Minutos Retraso] &lt; 5000 Then 1
  When [Measures].[Total Minutos Retraso] &gt;= 5000 And [Measures].[Total Minutos Retraso] &lt; 8000 Then 0
  Else -1
End</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="95ba9ede-528c-4431-bec5-90761d59dbe3">
      <ID>KPI 1</ID>
      <Name>KPI Costo Demoras</Name>
      <AssociatedMeasureGroupID>Fact Demora Vuelo</AssociatedMeasureGroupID>
      <Value>[Measures].[Costo Total Demoras]</Value>
      <Goal>100000</Goal>
      <Status>Case
  When [Measures].[Costo Total Demoras] &lt; 100000 Then 1
  When [Measures].[Costo Total Demoras] &gt;= 100000 And [Measures].[Costo Total Demoras] &lt; 150000 Then 0
  Else -1
End</Status>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Smiley Face</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>